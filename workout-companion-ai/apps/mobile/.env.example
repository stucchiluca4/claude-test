# Copia questo file in `.env` (nella stessa cartella) e inserisci i valori reali.
# Li trovi nella dashboard Supabase: Project Settings -> API.

# URL del progetto Supabase (es. https://abcdefgh.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://TUO-PROGETTO.supabase.co

# Chiave pubblica "anon" (NON la service_role: quella non va mai nell'app!)
EXPO_PUBLIC_SUPABASE_ANON_KEY=chiave-anon-di-esempio

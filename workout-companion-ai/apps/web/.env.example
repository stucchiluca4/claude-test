# ============================================================
# Copia questo file in `.env.local` e inserisci i valori veri.
# `.env.local` NON finisce mai su GitHub (è nel .gitignore).
# ============================================================

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TUO-PROGETTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=la-chiave-anon-public

# Chiave SEGRETA (service_role): solo per il server, mai nel browser
SUPABASE_SERVICE_ROLE_KEY=la-chiave-service-role

# --- Stripe (Developers → API keys, modalità Test) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ID dei prezzi creati nella dashboard Stripe (Products)
NEXT_PUBLIC_STRIPE_PRICE_COACH_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_COACH_PRO=price_...
NEXT_PUBLIC_STRIPE_PRICE_COACH_ELITE=price_...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
